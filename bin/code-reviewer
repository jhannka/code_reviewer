#!/usr/bin/env bash
# Resolve the absolute directory of this script
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_DIR="$( dirname "$SCRIPT_DIR" )"

# Run menu.py using the virtual environment python
PYTHONPATH="$PROJECT_DIR" "$PROJECT_DIR/.venv/bin/python" "$PROJECT_DIR/menu.py" "$@"
