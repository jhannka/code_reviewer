#!/usr/bin/env bash
# Resolve the absolute directory of this script, following symlinks
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
PROJECT_DIR="$( dirname "$SCRIPT_DIR" )"

# Run menu.py using the virtual environment python
PYTHONPATH="$PROJECT_DIR" "$PROJECT_DIR/.venv/bin/python" "$PROJECT_DIR/menu.py" "$@"
